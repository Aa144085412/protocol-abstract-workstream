# Copy to .env and fill in. The app loads .env automatically.
# Restart the app after editing (env vars load at startup, not on refresh).

# DEMO_MODE=true  -> no API calls, agents return realistic mock JSON. No key needed.
# DEMO_MODE=false -> real model calls (requires a key for the chosen provider).
DEMO_MODE=true

# Which LLM provider to use: "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic

# FORCE_CHEAP=true makes EVERY agent use the cheap model (e.g. Haiku-only / GPT-4o-mini).
# Set this if you want to avoid the more expensive "strong" model entirely.
FORCE_CHEAP=true

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_STRONG_MODEL=claude-sonnet-4-6

# --- OpenAI / ChatGPT (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o

# --- Per-agent routing (optional) ---
# Override the provider and/or exact model for individual agents. A <ROLE>_MODEL
# wins over tier/provider defaults and FORCE_CHEAP. Roles:
#   document, protocol, review, planner, search, chat, methods
#   <ROLE>_PROVIDER = anthropic | openai
#   <ROLE>_MODEL    = an exact model id for that provider
#
# RECOMMENDED MIX — ChatGPT for the detailed protocol, Haiku for planning/review:
#   DEMO_MODE=false
#   LLM_PROVIDER=anthropic        # everything defaults to Anthropic...
#   FORCE_CHEAP=true              # ...and to Haiku (cheap) by default
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...
#   PROTOCOL_PROVIDER=openai      # detailed protocol synthesis -> ChatGPT
#   PROTOCOL_MODEL=gpt-4o
#   DOCUMENT_PROVIDER=openai      # (optional) document extraction -> ChatGPT too
#   DOCUMENT_MODEL=gpt-4o-mini
# With the above: protocol = GPT-4o; planner, review, chat, methods, search = Haiku.

# Other examples:
# Haiku-only:    LLM_PROVIDER=anthropic + FORCE_CHEAP=true
# ChatGPT-cheap: LLM_PROVIDER=openai + FORCE_CHEAP=true (uses gpt-4o-mini)
