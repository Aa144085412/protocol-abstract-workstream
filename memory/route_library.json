        {"route_id": "library_scale_transformation", "label": "Library-scale transformation", "when_to_use": "maintain library complexity", "route_summary": ["many reactions", "pool", "titer", "expand"], "creates_value_uncertainties": ["number of reactions", "dilution for titer"], "risk_if_wrong": "bottlenecked complexity"}
