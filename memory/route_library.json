        {"route_id": "tenx_scrna_library", "label": "10x single-cell library", "when_to_use": "single-cell GEX/ATAC", "route_summary": ["load chip", "GEM", "barcode", "amplify", "construct"], "creates_value_uncertainties": ["target cell number", "PCR cycles"], "risk_if_wrong": "wrong loading concentration / multiplets"}
