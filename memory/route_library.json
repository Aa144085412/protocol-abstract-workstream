{
  "version": 1,
  "note": "Concept-category route families behind common procedural-shortcut phrases. Used by tools/route_library.py for deterministic detection and by ContextDigestAgent as grounded candidates. Each family stores example_phrases (semantic surface forms), match (verbs/nouns for offline detection), and possible routes. AI may add routes; it must not silently pick one.",
  "route_families": [
    {
      "route_family": "cell_preparation_for_seeding",
      "ambiguity_type": "cell_state",
      "semantic_meaning": "User wants cells placed into a culture vessel for a future experiment; the executable workflow depends on the starting cell state.",
      "route_question": "Where are the cells coming from / what state are they in?",
      "blocking_level": "must_ask_before_generation",
      "example_phrases": ["plate cells", "seed cells", "start cells", "split cells", "set up cells", "put cells into wells", "prepare cells", "prepare cells for transfection", "make cells ready for treatment", "make cells ready for transfection", "recover cells", "bring cells back", "passage cells"],
      "match": {"verbs": ["plate", "seed", "split", "passage", "prepare", "recover", "setup", "set", "put", "make", "start"], "nouns": ["cell", "cells", "culture", "well", "wells", "flask", "dish", "plate"]},
      "routes": [
        {"route_id": "thaw_from_cryo", "label": "Thaw frozen cells and plate", "when_to_use": "cells are from a cryostock vial", "route_summary": ["thaw", "dilute/recover", "optional spin", "count", "seed"], "creates_value_uncertainties": ["recovery medium volume", "spin speed", "seeding density"], "risk_if_wrong": "low viability if thawed slowly or wrong recovery medium"},
        {"route_id": "passage_adherent_cells", "label": "Passage adherent cells and plate", "when_to_use": "cells already growing adherently on a flask/plate", "route_summary": ["check confluency", "wash", "trypsinize", "neutralize", "count", "seed"], "creates_value_uncertainties": ["trypsin volume", "detach time", "seeding density"], "risk_if_wrong": "over-trypsinization or wrong confluency"},
        {"route_id": "dilute_suspension_cells", "label": "Dilute suspension cells and plate", "when_to_use": "cells grow in suspension", "route_summary": ["count", "dilute", "seed"], "creates_value_uncertainties": ["target density", "medium volume"], "risk_if_wrong": "wrong density changes growth/assay"},
        {"route_id": "recover_sorted_cells", "label": "Recover sorted/post-sort cells and plate", "when_to_use": "cells were just FACS-sorted or recovered", "route_summary": ["gentle spin", "resuspend in recovery medium", "count", "seed gently"], "creates_value_uncertainties": ["gentle spin speed", "recovery medium"], "risk_if_wrong": "fragile cells lyse at standard speeds"}
      ]
    },
    {
      "route_family": "reaction_purification",
      "ambiguity_type": "cleanup_method",
      "semantic_meaning": "User wants a nucleic-acid reaction cleaned up; methods preserve different size ranges and remove different contaminants.",
      "route_question": "Which cleanup strategy should be used?",
      "blocking_level": "must_ask_before_generation",
      "example_phrases": ["clean up reaction", "clean up pcr", "cleanup pcr", "purify pcr", "purify reaction", "purify the product", "remove primers", "buffer exchange"],
      "match": {"verbs": ["clean", "cleanup", "purify", "remove"], "nouns": ["pcr", "reaction", "product", "primers", "amplicon", "digest", "dna", "library"]},
      "routes": [
        {"route_id": "spri_beads", "label": "SPRI bead cleanup", "when_to_use": "PCR/library cleanup, size selection, buffer exchange", "route_summary": ["add beads at ratio", "bind", "ethanol wash", "elute"], "creates_value_uncertainties": ["bead ratio", "ethanol percentage", "elution volume"], "risk_if_wrong": "wrong bead ratio loses small fragments or retains adapter dimers"},
        {"route_id": "column_cleanup", "label": "Spin-column cleanup", "when_to_use": "standard PCR/digest cleanup with sufficient input", "route_summary": ["bind", "wash", "elute"], "creates_value_uncertainties": ["binding buffer ratio", "spin speed", "elution volume"], "risk_if_wrong": "column cutoff may lose short/low-input DNA"},
        {"route_id": "gel_extraction", "label": "Gel extraction", "when_to_use": "selecting a specific band", "route_summary": ["run gel", "excise band", "dissolve", "column"], "creates_value_uncertainties": ["elution volume"], "risk_if_wrong": "lower yield, UV damage"},
        {"route_id": "enzymatic_cleanup", "label": "Enzymatic cleanup (e.g. ExoSAP)", "when_to_use": "remove primers/dNTPs before a downstream reaction", "route_summary": ["add enzyme", "incubate", "heat-inactivate"], "creates_value_uncertainties": ["incubation time/temperature"], "risk_if_wrong": "does not remove salts/enzymes or wrong-size fragments"}
      ]
    },
    {
      "route_family": "nucleic_acid_extraction",
